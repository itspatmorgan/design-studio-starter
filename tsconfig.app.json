{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* Prototype views may be plain .jsx: allowed, but not type-checked */
    "allowJs": true,
    "checkJs": false,

    /* shadcn/ui import alias */
    "paths": { "@/*": ["./src/*"], "@module/*": ["./src/studio/modules/*/lib/index"] }
  },
  "include": ["src", "scripts/templates", "studio.config.ts"],
  "exclude": ["scripts/templates/module", "scripts/templates/system", "src/studio/modules/*/server.ts", "src/studio/fileTypes/canvas/cli.ts", "src/studio/fileTypes/canvas/tools.test.ts", "src/studio/fileTypes/view/lofi.test.ts", "src/studio/modules/handbook/handbook.test.ts", "src/studio/modules/systems/docs.test.ts", "src/studio/core/archive.test.ts", "src/studio/core/order.test.ts", "src/studio/modules/tools/staleLinks.test.ts", "src/studio/modules/modules.test.ts", "src/studio/modules/globs.test.ts", "src/studio/core/permissions.test.ts", "src/studio/core/config.test.ts", "src/studio/modules/systems/spec.test.ts", "src/studio/modules/pack.test.ts", "src/tools/quote-card/_components/text.test.ts", "src/studio/modules/tools/toolArt.test.ts"]
}
