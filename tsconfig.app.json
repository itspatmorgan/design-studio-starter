{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* Prototype views may be plain .jsx: allowed, but not type-checked */
    "allowJs": true,
    "checkJs": false,

    /* shadcn/ui import alias */
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "scripts/templates"],
  "exclude": ["src/studio/fileTypes/canvas/cli.ts", "src/studio/fileTypes/canvas/tools.test.ts", "src/studio/fileTypes/view/lofi.test.ts", "src/studio/handbook.test.ts", "src/studio/systemDocs.test.ts", "src/studio/archive.test.ts", "src/studio/order.test.ts"]
}
