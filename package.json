{
  "name": "design-studio-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-manifest.js && vite",
    "build": "node scripts/build-manifest.js --strict --deploy && node scripts/check-file-types.js && node scripts/check-modules.js && pnpm test && pnpm typecheck && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "new": "node scripts/create-prototype.js",
    "join": "node scripts/setup-contributor.js",
    "component-docs": "node scripts/scaffold-component-docs.js",
    "prepare": "husky",
    "check": "node scripts/check-file-types.js && node scripts/check-modules.js",
    "baseline": "node scripts/baseline.js",
    "canvas": "node src/studio/fileTypes/canvas/cli.ts",
    "test": "node --test src/studio/fileTypes/canvas/tools.test.ts src/studio/fileTypes/view/lofi.test.ts src/studio/handbook.test.ts src/studio/systemDocs.test.ts src/studio/archive.test.ts src/studio/order.test.ts src/studio/tools.test.ts src/studio/modules/modules.test.ts src/studio/modules/globs.test.ts src/tools/quote-card/_components/text.test.ts src/studio/app/pages/tools/toolArt.test.ts"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^4.0.0",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^3.0.0",
    "@base-ui/react": "^1.8.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@excalidraw/excalidraw": "0.18.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/comic-neue": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.4",
    "@lezer/markdown": "^1.7.2",
    "@mdx-js/react": "^3.1.1",
    "@tanstack/react-router": "^1.170.40",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.6",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "husky": "^9.1.7",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^6.0.0",
    "shiki": "^4.4.3",
