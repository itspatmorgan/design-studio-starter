    {
      "height": 458,
      "id": "mup2hspz2qdsg4",
      "name": "5. Lofi is a switch on a view",
      "seed": 1516139933,
      "type": "frame",
      "version": 2,
      "versionNonce": 179436400,
      "width": 1800,
      "x": -60,
      "y": 1581
    },
    {
      "autoResize": false,
      "fontFamily": 6,
      "fontSize": 18,
      "frameId": "mup2htq5l40pmt",
      "height": 270,
      "id": "mup2ht81ox7iqd",
      "lineHeight": 1.25,
      "originalText": "A canvas is a page for arranging live views, documents, and notes. This prototype has two, for two moments.\n\nBreadboard is for early ideas: only Excalidraw's own shapes, rough on purpose. Eng handoff is for when the design is settled: the real screens live, with a note under each saying what engineering needs to know.\n\nDrag any view from the navigation onto a canvas, or ask your agent to lay something out. A canvas shows only this prototype's own screens.",
      "seed": 1880775715,
      "text": "A canvas is a page for arranging live views,\ndocuments, and notes. This prototype has two, for\ntwo moments.\n\nBreadboard is for early ideas: only Excalidraw's own\nshapes, rough on purpose. Eng handoff is for when\nthe design is settled: the real screens live, with a note\nunder each saying what engineering needs to know.\n\nDrag any view from the navigation onto a canvas, or\nask your agent to lay something out. A canvas shows\nonly this prototype's own screens.",
      "textAlign": "left",
      "type": "text",
      "version": 3,
      "versionNonce": 12028548,
      "verticalAlign": "top",
      "width": 460,
      "x": 0,
      "y": 2179
    },
