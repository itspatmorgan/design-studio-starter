    {
      "height": 458,
      "id": "mup2hpoc2hkb3a",
      "name": "2. The screens",
      "seed": 2133907070,
      "type": "frame",
      "version": 1,
      "versionNonce": 1218750592,
      "width": 1800,
      "x": -60,
