      "frameId": "mup2au4pk7z8nt",
      "height": 90,
      "id": "mup2au4o7cu3l9",
      "lineHeight": 1.25,
      "originalText": "• Right-click a file on the left and choose Edit source. Change a title and the screen updates.\n• Right-click Lofi / Feedback Inbox and try Make hi-fi, then Make lofi.\n• Drag files in the list to reorder them, or onto a folder to move them.\n• Ask your agent for a change: \"add a due date to feedback\".",
      "seed": 1965376001,
      "text": "• Right-click a file on the left and choose Edit source. Change a title and the screen updates.\n• Right-click Lofi / Feedback Inbox and try Make hi-fi, then Make lofi.\n• Drag files in the list to reorder them, or onto a folder to move them.\n• Ask your agent for a change: \"add a due date to feedback\".",
      "textAlign": "left",
      "type": "text",
      "version": 2,
      "versionNonce": 1600865305,
      "verticalAlign": "top",
      "width": 1000,
      "x": 0,
      "y": 1900
    },
