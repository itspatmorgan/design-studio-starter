    },
    {
      "autoResize": false,
      "fontFamily": 6,
      "fontSize": 18,
      "frameId": "mup2hvq5emw1xy",
      "height": 90,
      "id": "mup2hv88yqfzrp",
      "lineHeight": 1.25,
      "originalText": "Project context is the document this prototype's agent should read first: the problem, who it is for, and what you have decided. A few honest paragraphs beat a long spec.",
      "seed": 746772687,
      "text": "Project context is the document this prototype's agent\nshould read first: the problem, who it is for, and what\nyou have decided. A few honest paragraphs beat a\nlong spec.",
      "textAlign": "left",
      "type": "text",
      "version": 3,
      "versionNonce": 1248335750,
      "verticalAlign": "top",
      "width": 460,
      "x": 0,
      "y": 3187
    },
    {
      "customData": {
        "frame": true,
        "hideLinkIcon": true
      },
      "frameId": "mup2hvq5emw1xy",
