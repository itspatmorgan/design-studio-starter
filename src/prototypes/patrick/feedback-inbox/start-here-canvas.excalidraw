      "version": 3,
      "versionNonce": 750335698,
      "width": 480,
      "x": 560,
      "y": 3187
    },
    {
      "height": 210,
      "id": "mup2hvq5emw1xy",
      "name": "8. Write down the why",
      "seed": 36010483,
      "type": "frame",
      "version": 3,
      "versionNonce": 1260409553,
      "width": 1800,
      "x": -60,
      "y": 3127
    },
    {
      "autoResize": false,
      "fontFamily": 6,
      "fontSize": 18,
      "frameId": "mup2hwqmhg0w9n",
      "height": 180,
      "id": "mup2hw8bh28l1k",
      "lineHeight": 1.25,
      "originalText": "Your agent can build and change all of this. Try:\n\n• \"add a due date to feedback\"\n• \"make the overview show a chart\"\n• \"write up the open questions as a document\"\n• \"put the new screen on the handoff canvas\"\n\nIt reads the same files you see.",
      "seed": 1304314660,
      "text": "Your agent can build and change all of this. Try:\n\n• \"add a due date to feedback\"\n• \"make the overview show a chart\"\n• \"write up the open questions as a document\"\n• \"put the new screen on the handoff canvas\"\n\nIt reads the same files you see.",
      "textAlign": "left",
      "type": "text",
      "version": 3,
      "versionNonce": 2046879469,
      "verticalAlign": "top",
      "width": 460,
      "x": 0,
      "y": 3477
    },
    {
      "height": 300,
      "id": "mup2hwqmhg0w9n",
      "name": "9. Work with your agent",
      "seed": 1069478907,
