    {
      "height": 458,
      "id": "mup2huq7pfzy3b",
      "name": "7. A view for every state",
      "seed": 1794102886,
      "type": "frame",
      "version": 2,
      "versionNonce": 175320720,
      "width": 1800,
      "x": -60,
