    {
      "height": 390,
      "id": "mup2htq5l40pmt",
      "name": "6. Think on a canvas",
      "seed": 437042366,
      "type": "frame",
      "version": 2,
      "versionNonce": 1379647554,
      "width": 1800,
      "x": -60,
