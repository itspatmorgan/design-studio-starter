    },
    {
      "autoResize": false,
      "fontFamily": 6,
      "fontSize": 18,
      "frameId": "mup2hqopasdse9",
      "height": 157.5,
      "id": "mup2hq6n3eps6s",
      "lineHeight": 1.25,
      "originalText": "Right-click any file in the navigation and choose Edit source to see its text. While the app runs on your computer you can edit it right there and save with ⌘S, then press Done to go back. The change shows up straight away.\n\nTry changing a title in the Feedback inbox.",
      "seed": 900454447,
      "text": "Right-click any file in the navigation and choose Edit\nsource to see its text. While the app runs on your\ncomputer you can edit it right there and save with ⌘S,\nthen press Done to go back. The change shows up\nstraight away.\n\nTry changing a title in the Feedback inbox.",
      "textAlign": "left",
      "type": "text",
      "version": 2,
      "versionNonce": 571160199,
      "verticalAlign": "top",
      "width": 460,
      "x": 0,
      "y": 1283
    },
    {
      "height": 277.5,
      "id": "mup2hqopasdse9",
      "name": "3. Switch to Source",
      "seed": 718015031,
      "type": "frame",
      "version": 3,
      "versionNonce": 119339302,
      "width": 880,
      "x": -60,
      "y": 1223
    },
    {
      "autoResize": false,
      "fontFamily": 6,
      "fontSize": 18,
      "frameId": "mup2hrptx1it9",
      "height": 157.5,
      "id": "mup2hr77e4tprx",
      "lineHeight": 1.25,
      "originalText": "Turn on Show all files in the … menu and look inside the app folder. A name that starts with an underscore, like _components, marks a helper, not a screen, so it never appears in the navigation.\n\nHelpers are how three screens share one set of pieces without repeating them.",
      "seed": 2113318538,
      "text": "Turn on Show all files in the … menu and look inside\nthe app folder. A name that starts with an underscore,\nlike _components, marks a helper, not a screen, so it\nnever appears in the navigation.\n\nHelpers are how three screens share one set of pieces\nwithout repeating them.",
      "textAlign": "left",
      "type": "text",
      "version": 3,
      "versionNonce": 566852094,
      "verticalAlign": "top",
      "width": 460,
      "x": 920,
      "y": 1283
    },
    {
      "height": 278,
      "id": "mup2hrptx1it9",
      "name": "4. The helpers folder",
      "seed": 323976330,
      "type": "frame",
      "version": 4,
      "versionNonce": 1941464811,
      "width": 880,
      "x": 860,
      "y": 1223
    },
    {
      "autoResize": false,
      "fontFamily": 6,
      "fontSize": 18,
      "frameId": "mup2hspz2qdsg4",
      "height": 202.5,
      "id": "mup2hs7tsmo5r4",
      "lineHeight": 1.25,
      "originalText": "The lofi Feedback inbox is the real one with /** @lofi */ at the top of its file. That one line is the whole feature: the screen keeps its design system's components and is drawn in grayscale with handwritten type, for when you are deciding the layout and polish would only distract.\n\nRight-click any view and choose Make lofi to try it, and Make hi-fi to undo it.",
      "seed": 1582523772,
      "text": "The lofi Feedback inbox is the real one with /** @lofi\n*/ at the top of its file. That one line is the whole\nfeature: the screen keeps its design system's\ncomponents and is drawn in grayscale with\nhandwritten type, for when you are deciding the\nlayout and polish would only distract.\n\nRight-click any view and choose Make lofi to try it,\nand Make hi-fi to undo it.",
      "textAlign": "left",
      "type": "text",
      "version": 3,
      "versionNonce": 511860312,
      "verticalAlign": "top",
      "width": 460,
      "x": 0,
