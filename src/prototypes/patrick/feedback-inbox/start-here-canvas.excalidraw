    },
    {
      "autoResize": false,
      "fontFamily": 6,
      "fontSize": 18,
      "frameId": "mup2huq7pfzy3b",
      "height": 202.5,
      "id": "mup2hu864t8xxe",
      "lineHeight": 1.25,
      "originalText": "A screen has more states than the one you land on: filtered, empty, a panel open, a dialog asking first. Each is a small file in the states folder that shows the same screen already in that state.\n\nThey are ordinary views, so you can open them and a canvas can embed them. That is how the handoff canvas shows a closed panel and an open one side by side.",
      "seed": 37418853,
      "text": "A screen has more states than the one you land on:\nfiltered, empty, a panel open, a dialog asking first.\nEach is a small file in the states folder that shows the\nsame screen already in that state.\n\nThey are ordinary views, so you can open them and a\ncanvas can embed them. That is how the handoff\ncanvas shows a closed panel and an open one side by\nside.",
      "textAlign": "left",
      "type": "text",
      "version": 3,
      "versionNonce": 210771088,
      "verticalAlign": "top",
      "width": 460,
      "x": 0,
      "y": 2649
    },
