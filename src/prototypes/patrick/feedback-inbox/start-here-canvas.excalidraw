    {
      "height": 345,
      "id": "mup2hooae4hn3k",
      "name": "1. The files on the left",
      "seed": 606837308,
      "type": "frame",
      "version": 1,
      "versionNonce": 2100309463,
      "width": 1800,
      "x": -60,
      "y": 260
    },
    {
      "autoResize": false,
      "fontFamily": 6,
      "fontSize": 18,
      "frameId": "mup2hpoc2hkb3a",
      "height": 270,
      "id": "mup2hp6oaqk0jr",
      "lineHeight": 1.25,
      "originalText": "Open the Overview. Click Open issues and you land in the Feedback inbox, already narrowed to everything not resolved. Add feedback, click a row, change its status, add a note, delete something.\n\nThe three screens share one set of data, so a change in one shows up in the others. Reload the page, or choose Reset sample data, to start over.\n\nThey use the Product design system, the same components your team's product would use. See them on the Systems page.",
      "seed": 1151376416,
      "text": "Open the Overview. Click Open issues and you land in\nthe Feedback inbox, already narrowed to everything\nnot resolved. Add feedback, click a row, change its\nstatus, add a note, delete something.\n\nThe three screens share one set of data, so a change\nin one shows up in the others. Reload the page, or\nchoose Reset sample data, to start over.\n\nThey use the Product design system, the same\ncomponents your team's product would use. See them\non the Systems page.",
      "textAlign": "left",
      "type": "text",
      "version": 2,
      "versionNonce": 1156138974,
      "verticalAlign": "top",
      "width": 460,
      "x": 0,
      "y": 745
