{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,
    "allowJs": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts", "src/studio/modules/*/server.ts", "src/studio/fileTypes/canvas/cli.ts", "src/studio/fileTypes/canvas/tools.test.ts", "src/studio/fileTypes/view/lofi.test.ts", "src/studio/handbook.test.ts", "src/studio/systemDocs.test.ts", "src/studio/archive.test.ts", "src/studio/order.test.ts", "src/studio/modules/tools/staleLinks.test.ts", "src/studio/modules/modules.test.ts", "src/studio/modules/globs.test.ts", "src/studio/permissions.test.ts", "src/studio/config.test.ts", "src/studio/systems.test.ts", "src/tools/quote-card/_components/text.test.ts", "src/studio/modules/tools/toolArt.test.ts"]
}
